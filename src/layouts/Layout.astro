---
// Main Layout Component - Grunapotheke Medical Cannabis

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: 'website' | 'article' | 'product';
  keywords?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}

const {
  title,
  description,
  canonical,
  ogImage,
  ogImageAlt,
  ogType,
  keywords,
  structuredData,
  noindex = false,
} = Astro.props;

const siteUrl = 'https://grunapotheke.com';
const currentPath = Astro.url.pathname;
const pageUrl = canonical || `${siteUrl}${currentPath === '/' ? '' : currentPath.replace(/\/$/, '')}`;
const defaultOgImage = `${siteUrl}/images/og-default.png`;
const resolvedOgImage = ogImage ? (ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`) : defaultOgImage;
const inferredOgType = currentPath.startsWith('/ratgeber/') ? 'article' : 'website';
const resolvedOgType = ogType || inferredOgType;
const normalizedTitle = title.replace(/\s*[\-|\u2013]\s*Grunapotheke\s*$/i, '').trim() || title;
const resolvedOgImageAlt = ogImageAlt || `${normalizedTitle} - Grunapotheke`;
const robotsContent = noindex
  ? 'noindex, nofollow, noarchive'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';
const globalSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${siteUrl}/#organization`,
      name: 'Grunapotheke',
      url: siteUrl,
      logo: {
        '@type': 'ImageObject',
        url: `${siteUrl}/images/og-default.png`,
      },
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      url: siteUrl,
      name: 'Grunapotheke',
      inLanguage: 'de-DE',
      publisher: {
        '@id': `${siteUrl}/#organization`,
      },
      potentialAction: {
        '@type': 'SearchAction',
        target: `${siteUrl}/products?q={search_term_string}`,
        'query-input': 'required name=search_term_string',
      },
    },
    {
      '@type': 'WebPage',
      '@id': `${pageUrl}#webpage`,
      url: pageUrl,
      name: title,
      description,
      isPartOf: {
        '@id': `${siteUrl}/#website`,
      },
      inLanguage: 'de-DE',
    },
  ],
};

import '../styles/global.css';
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    <meta name="robots" content={robotsContent} />
    <meta name="googlebot" content={robotsContent} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="canonical" href={pageUrl} />
    <link rel="sitemap" type="application/xml" href={`${siteUrl}/sitemap-index.xml`} />
    <link rel="alternate" hreflang="de" href={pageUrl} />
    <link rel="alternate" hreflang="x-default" href={pageUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:type" content={resolvedOgType} />
    <meta property="og:site_name" content="Grunapotheke" />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:alt" content={resolvedOgImageAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />
    <meta name="twitter:image:alt" content={resolvedOgImageAlt} />
