    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  /* Header */
  .header {
    background: #1a472a;
    color: white;
    padding: 0.75rem 0;
    position: sticky;
    top: 0;
    z-index: 1000;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.15);
  }

  .nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

