---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

const siteUrl = 'https://grunapotheke.de';
const pageUrl = `${siteUrl}/gras-kaufen`;

const webpageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Gras kaufen in Deutschland - medizinisch und legal mit Rezept',
  description: 'Gras kaufen bei Grunapotheke: medizinisches Cannabis mit Rezept, diskret und schnell geliefert.',
  url: pageUrl,
  inLanguage: 'de-DE',
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Kann ich legal Gras kaufen?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Medizinisches Cannabis kann in Deutschland mit gueltigem Rezept legal gekauft werden. Der Bezug erfolgt ueber eine zugelassene Apotheke.',
      },
    },
    {
      '@type': 'Question',
      name: 'Wie laeuft der Kauf von Gras auf Rezept ab?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Du beantragst online dein Rezept, waehlst ein passendes Produkt und bestellst danach in der Apotheke. Der Versand erfolgt diskret.',
      },
    },
    {
      '@type': 'Question',
      name: 'Welche Produkte gibt es bei Grunapotheke?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Verfuegbar sind unter anderem Cannabisblueten, Extrakte, THC Vapes, THC Shots sowie Kapseln und Edibles.',
      },
    },
  ],
};
---

<Layout
  title="Gras kaufen 2026 | Medizinisches Cannabis legal auf Rezept - Grunapotheke"
  description="Gras kaufen in Deutschland: Bei Grunapotheke bestellst du medizinisches Cannabis legal mit Rezept. Ueber 180 Produkte, faire Preise und diskrete Lieferung."
  keywords="gras kaufen, gras kaufen deutschland, gras auf rezept, medizinisches gras kaufen, legal gras kaufen"
  canonical={pageUrl}
  structuredData={[webpageSchema, faqSchema]}
>
  <Breadcrumb items={[{ name: 'Gras kaufen' }]} />

  <section class="hero">
    <div class="container">
      <p class="eyebrow">SEO Landingpage</p>
      <h1>Gras kaufen: so geht es legal in Deutschland</h1>
      <p class="lead">
        Der Suchbegriff <strong>gras kaufen</strong> wird oft verwendet, wenn medizinisches Cannabis gemeint ist.
        Mit gueltigem Rezept kannst du bei Grunapotheke legal bestellen und diskret liefern lassen.
      </p>
      <div class="hero-cta">
        <a href="/products" class="btn btn-primary">Jetzt Produkte ansehen</a>
        <a href="/wie-funktionierts" class="btn btn-secondary">Rezeptablauf ansehen</a>
      </div>
    </div>
  </section>

  <section class="main">
    <div class="container grid">
      <article class="content">
        <h2>Was bedeutet Gras kaufen im medizinischen Kontext?</h2>
        <p>
          Viele Nutzer suchen nach gras kaufen, meinen aber den legalen Kauf von medizinischem Cannabis.
          Entscheidend ist ein aertzliches Rezept und der Bezug ueber eine Apotheke.
        </p>

        <h2>Schritt fuer Schritt: Gras kaufen mit Rezept</h2>
        <ol>
          <li>Im <a href="/wie-funktionierts">Online-Ablauf</a> starten und medizinische Angaben machen.</li>
          <li>Rezept pruefen lassen und nach Freigabe passende Produkte waehlen.</li>
          <li>Im <a href="/products">Live-Bestand</a> bestellen und diskret liefern lassen.</li>
        </ol>

        <h2>Welche Formen von medizinischem Cannabis kannst du kaufen?</h2>
        <ul>
          <li><a href="/kategorie/cannabisblueten">Gras kaufen als Cannabisblueten</a></li>
          <li><a href="/kategorie/cannabisextrakte">Cannabisextrakte kaufen</a></li>
          <li><a href="/kategorie/thc-vapes">THC Vapes kaufen</a></li>
          <li><a href="/kategorie/thc-shots">THC Shots kaufen</a></li>
          <li><a href="/kategorie/kapseln-edibles">Kapseln und Edibles kaufen</a></li>
        </ul>

        <h2>Warum Grunapotheke?</h2>
        <p>
          Grunapotheke verbindet telemedizinischen Zugang, verifizierte Qualitaet und transparente Preise.
          Dadurch wird der Prozess fuer Patienten einfacher, schneller und verlaesslicher.
        </p>

        <h2>Hauefige Fragen zu gras kaufen</h2>
        <details>
          <summary>Kann ich ohne Rezept Gras kaufen?</summary>
          <p>Fuer medizinisches Cannabis benoetigst du ein gueltiges Rezept.</p>
        </details>
        <details>
          <summary>Wie lange dauert der Versand?</summary>
          <p>In der Regel 1-3 Werktage nach erfolgreicher Bestellung.</p>
        </details>
        <details>
          <summary>Wo finde ich die aktuellen Kosten?</summary>
          <p>Sieh dir die <a href="/preise">Preise</a> und den <a href="/products">Live-Bestand</a> an.</p>
        </details>
      </article>

      <aside class="sidebar">
        <div class="panel">
          <h3>Schnelleinstieg</h3>
          <ul>
            <li><a href="/cannabis-kaufen">Cannabis kaufen</a></li>
            <li><a href="/cannabis-arzt">Cannabis Arzt</a></li>
            <li><a href="/indikationen">Indikationen</a></li>
            <li><a href="/faq">FAQ</a></li>
          </ul>
        </div>
        <div class="panel highlight">
          <h3>Direkt starten</h3>
          <p>In wenigen Minuten zum Rezeptantrag.</p>
          <a class="btn btn-primary" href="/wie-funktionierts">Jetzt starten</a>
        </div>
      </aside>
    </div>
  </section>
</Layout>

<style>
  .container {
    max-width: 1100px;
    margin: 0 auto;
  }

  .hero {
    padding: 3.5rem 1.5rem 2.5rem;
    background: linear-gradient(135deg, #f3faf5 0%, #e0f1e5 100%);
    border-bottom: 1px solid #dce9df;
  }

  .eyebrow {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #2a6b45;
    margin-bottom: 0.75rem;
  }

  h1 {
    margin: 0;
    color: #113625;
    line-height: 1.15;
    font-size: clamp(1.9rem, 4vw, 2.7rem);
  }

  .lead {
    margin-top: 1rem;
    max-width: 70ch;
    color: #345546;
    line-height: 1.7;
    font-size: 1.05rem;
  }

  .hero-cta {
    margin-top: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  .btn {
    display: inline-block;
    border-radius: 999px;
    padding: 0.72rem 1.15rem;
    font-weight: 600;
    text-decoration: none;
  }

  .btn-primary {
    background: #2a6b45;
    color: #fff;
  }

  .btn-primary:hover {
    background: #22563a;
    color: #fff;
  }

  .btn-secondary {
    border: 1px solid #2a6b45;
    color: #2a6b45;
    background: #fff;
  }

  .btn-secondary:hover {
    background: #f2f8f4;
    color: #1f4f34;
  }

  .main {
    padding: 2.25rem 1.5rem 3.5rem;
  }

  .grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 1.5rem;
    align-items: start;
  }

  .content {
    border: 1px solid #e2ebe5;
    border-radius: 16px;
    padding: 1.5rem;
    background: #fff;
  }

  .content h2 {
    margin-top: 1.4rem;
    color: #153a28;
    font-size: 1.35rem;
  }

  .content h2:first-child {
    margin-top: 0;
  }

  .content p,
  .content li {
    color: #355347;
    line-height: 1.75;
  }

  .content ol,
  .content ul {
    padding-left: 1.2rem;
  }

  .content a {
    color: #1f6a42;
    text-underline-offset: 2px;
  }

  details {
    margin-top: 0.8rem;
    border: 1px solid #e5eee8;
    background: #fbfdfb;
    border-radius: 10px;
    padding: 0.75rem 0.9rem;
  }

  summary {
    cursor: pointer;
    font-weight: 600;
    color: #173d2a;
  }

  .sidebar {
    display: grid;
    gap: 1rem;
  }

  .panel {
    border: 1px solid #e2ebe5;
    background: #fff;
    border-radius: 14px;
    padding: 1rem;
  }

  .panel h3 {
    margin: 0 0 0.75rem;
    color: #173d2a;
  }

  .panel ul {
    margin: 0;
    padding-left: 1rem;
  }

  .panel li {
    margin-bottom: 0.4rem;
  }

  .panel a {
    color: #1f6a42;
  }

  .highlight p {
    color: #365548;
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
