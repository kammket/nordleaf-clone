---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

const siteUrl = 'https://grunapotheke.com';
const pageUrl = `${siteUrl}/cannabis-kaufen`;

const webpageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Cannabis kaufen in Deutschland - medizinisches Cannabis auf Rezept',
  description: 'Cannabis kaufen bei Grunapotheke: medizinisches Cannabis auf Rezept mit schneller Lieferung in 1-3 Werktagen.',
  url: pageUrl,
  inLanguage: 'de-DE',
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Kann ich in Deutschland legal Cannabis kaufen?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Medizinisches Cannabis kann in Deutschland legal mit einem gueltigen Rezept gekauft werden. Bei Grunapotheke erfolgt der Kauf ueber eine zugelassene Apotheke.',
      },
    },
    {
      '@type': 'Question',
      name: 'Wie kann ich medizinisches Cannabis kaufen?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Du waehlst ein Produkt, beantragst dein Rezept online und bestellst danach in der Apotheke. Der Versand erfolgt diskret und schnell.',
      },
    },
    {
      '@type': 'Question',
      name: 'Welche Cannabis Produkte kann ich kaufen?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Du kannst Cannabisblueten, Cannabisextrakte, THC Vapes, THC Shots sowie Kapseln und Edibles mit Rezept kaufen.',
      },
    },
  ],
};
---

<Layout
  title="Cannabis kaufen 2026 | Medizinisches Cannabis auf Rezept - Grunapotheke"
  description="Cannabis kaufen bei Grunapotheke: medizinisches Cannabis auf Rezept, ueber 180 Produkte, diskrete Lieferung in 1-3 Werktagen und transparente Preise."
  keywords="cannabis kaufen, medizinisches cannabis kaufen, cannabis auf rezept, cannabis apotheke online, thc kaufen deutschland"
  canonical={pageUrl}
  structuredData={[webpageSchema, faqSchema]}
>
  <Breadcrumb items={[{ name: 'Cannabis kaufen' }]} />

  <section class="hero">
    <div class="container">
      <p class="kicker">Medizinische Cannabis-Versorgung in Deutschland</p>
      <h1>Cannabis kaufen: medizinisches Cannabis auf Rezept</h1>
      <p class="lead">
        Wenn du in Deutschland Cannabis kaufen moechtest, ist der sichere Weg der Kauf von
        <strong> medizinischem Cannabis auf Rezept</strong>. Bei Grunapotheke findest du ein breites Sortiment,
        klare Preise und schnelle Lieferung.
      </p>
      <div class="hero-actions">
        <a href="/products" class="btn btn-primary">Jetzt Cannabis kaufen</a>
        <a href="/wie-funktionierts" class="btn btn-outline">So funktioniert es</a>
      </div>
    </div>
  </section>

  <section class="content">
    <div class="container content-grid">
      <article>
        <h2>So kannst du Cannabis kaufen</h2>
        <ol>
          <li><strong>Produkte waehlen:</strong> Entdecke den <a href="/products">Live-Bestand</a> mit verfuegbaren Sorten.</li>
          <li><strong>Rezept erhalten:</strong> Starte ueber <a href="/wie-funktionierts">den Fragebogen</a> und lasse dein Rezept pruefen.</li>
          <li><strong>Bestellung abschliessen:</strong> Kaufe dein medizinisches Cannabis in der Apotheke und erhalte es per Versand.</li>
        </ol>

        <h2>Welche Produkte kannst du kaufen?</h2>
        <p>
          Je nach Bedarf und aerztlicher Empfehlung kannst du verschiedene Darreichungsformen
          fuer deine Therapie kaufen:
        </p>
        <ul>
          <li><a href="/kategorie/cannabisblueten">Cannabisblueten kaufen</a></li>
          <li><a href="/kategorie/cannabisextrakte">Cannabisextrakte kaufen</a></li>
          <li><a href="/kategorie/thc-vapes">THC Vapes kaufen</a></li>
          <li><a href="/kategorie/thc-shots">THC Shots kaufen</a></li>
          <li><a href="/kategorie/kapseln-edibles">THC Kapseln und Edibles kaufen</a></li>
        </ul>

        <h2>Cannabis kaufen: legal und sicher</h2>
        <p>
          Medizinisches Cannabis ist in Deutschland verschreibungspflichtig. Mit einem gueltigen
          Rezept kannst du legal Cannabis kaufen. Grunapotheke arbeitet mit einer zugelassenen
          Apotheke und bietet dir einen sicheren Bestellprozess.
        </p>

        <h2>Haeufige Fragen zum Cannabis kaufen</h2>
        <details>
          <summary>Ist Cannabis kaufen ohne Rezept moeglich?</summary>
          <p>Fuer medizinisches Cannabis brauchst du ein Rezept. Danach kannst du legal kaufen.</p>
        </details>
        <details>
          <summary>Wie schnell wird geliefert?</summary>
          <p>In der Regel erfolgt die Lieferung innerhalb von 1-3 Werktagen.</p>
        </details>
        <details>
          <summary>Wo finde ich Preise?</summary>
          <p>
            Alle aktuellen Preise findest du im <a href="/products">Live-Bestand</a> und auf der
            <a href="/preise">Preisseite</a>.
          </p>
        </details>
      </article>

      <aside class="sidebar">
        <div class="card">
          <h3>Direkte Einstiege</h3>
          <ul>
            <li><a href="/products">Alle Produkte ansehen</a></li>
            <li><a href="/cannabis-arzt">Cannabis Arzt finden</a></li>
            <li><a href="/indikationen">Indikationen ansehen</a></li>
            <li><a href="/faq">FAQ lesen</a></li>
          </ul>
        </div>
        <div class="card cta">
          <h3>Jetzt starten</h3>
          <p>Starte in wenigen Minuten und beantrage dein Rezept online.</p>
          <a href="/wie-funktionierts" class="btn btn-primary">Rezept beantragen</a>
        </div>
      </aside>
    </div>
  </section>
</Layout>

<style>
  .hero {
    background: linear-gradient(135deg, #f4fbf6, #e7f5eb);
    padding: 3.5rem 1.5rem 2.5rem;
    border-bottom: 1px solid #dbeadf;
  }

  .container {
    max-width: 1100px;
    margin: 0 auto;
  }

  .kicker {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #2d6a47;
    font-weight: 700;
    margin-bottom: 0.75rem;
  }

  h1 {
    font-size: clamp(1.9rem, 4vw, 2.8rem);
    line-height: 1.15;
    color: #123524;
    margin: 0 0 1rem;
  }

  .lead {
    max-width: 70ch;
    color: #345445;
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    gap: 0.85rem;
    flex-wrap: wrap;
    margin-top: 1.5rem;
  }

  .btn {
    display: inline-block;
    padding: 0.75rem 1.15rem;
    border-radius: 999px;
    font-weight: 600;
    text-decoration: none;
  }

  .btn-primary {
    background: #2d6a47;
    color: #fff;
  }

  .btn-primary:hover {
    background: #24573a;
    color: #fff;
  }

  .btn-outline {
    border: 1px solid #2d6a47;
    color: #2d6a47;
    background: #fff;
  }

  .btn-outline:hover {
    background: #f1f8f3;
    color: #1f4a33;
  }

  .content {
    padding: 2.25rem 1.5rem 3.5rem;
  }

  .content-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 1.5rem;
    align-items: start;
  }

  article {
    background: #fff;
    border: 1px solid #e4ece7;
    border-radius: 16px;
    padding: 1.5rem;
  }

  article h2 {
    margin-top: 1.5rem;
    color: #153a28;
    font-size: 1.4rem;
  }

  article h2:first-child {
    margin-top: 0;
  }

  article p,
  article li {
    color: #334b3f;
    line-height: 1.75;
  }

  article ol,
  article ul {
    padding-left: 1.2rem;
  }

  article a {
    color: #1f6b42;
    text-underline-offset: 2px;
  }

  details {
    border: 1px solid #e6eee8;
    border-radius: 10px;
    padding: 0.75rem 0.9rem;
    margin-top: 0.75rem;
    background: #fbfdfb;
  }

  summary {
    cursor: pointer;
    font-weight: 600;
    color: #183c2a;
  }

  .sidebar {
    display: grid;
    gap: 1rem;
  }

  .card {
    border: 1px solid #e2ebe5;
    border-radius: 14px;
    background: #fff;
    padding: 1rem;
  }

  .card h3 {
    margin: 0 0 0.75rem;
    color: #173c2a;
  }

  .card ul {
    margin: 0;
    padding-left: 1rem;
  }

  .card li {
    margin-bottom: 0.4rem;
  }

  .card a {
    color: #1f6b42;
  }

  .cta p {
    color: #355347;
  }

  @media (max-width: 900px) {
    .content-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
